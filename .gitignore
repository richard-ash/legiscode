### Project ###
node_modules/
.pnpm-store/
dist/
coverage/

# Module build output. `mise run corpus:build` writes here; never commit
# generated modules — committed fixtures in test/fixtures/ are the
# reproducibility surface. See feat/corpus-parser plan. Anchored to repo
# root so `src/build/` (the @/build module) and `test/build/` (its tests)
# are NOT excluded.
/build/

# Electron build outputs. `electron-vite build` writes to /out/;
# `electron-builder --dir` writes to /dist-electron/. Both are local-only.
/out/
/dist-electron/

# Author-side dev cache for live AmLegal fetches (only used by scheduled
# refresh job in feat/build-pipeline; tests are hermetic via committed
# fixtures and never hit the network).
data/amlegal-snapshots/

corpus.new/
.gstack/

# Local agent state (codex session IDs, etc.) — never committed.
.context/

# Playwright artifacts — traces and reports are produced per-run; only the
# config + test sources are committed.
/test-results/
/playwright-report/
/.playwright/
