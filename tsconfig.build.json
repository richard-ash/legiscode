{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "test/**/*",
    "**/*.test.ts",
    "src/app/**",
    "src/ui/**",
    "src/styles/**",
    "src/theme-bootstrap.ts",
    "src/index.html"
  ]
}
